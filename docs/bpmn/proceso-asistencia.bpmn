      <bpmndi:BPMNShape id="Lane_Jefe_di" bpmnElement="Lane_Jefe" isHorizontal="true"><dc:Bounds x="190" y="400" width="2170" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_RRHH_di" bpmnElement="Lane_RRHH" isHorizontal="true"><dc:Bounds x="190" y="520" width="2170" height="120" /></bpmndi:BPMNShape>
