        <dc:Bounds x="2060" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidarReporte_di" bpmnElement="Task_ValidarReporte">
        <dc:Bounds x="2060" y="540" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GestionarRenovacion_di" bpmnElement="Task_GestionarRenovacion">
        <dc:Bounds x="805" y="660" width="100" height="80" />
      </bpmndi:BPMNShape>
